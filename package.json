{
  "name": "cvaurum",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CVAurum — the open-source resume studio. Beautiful, ATS-ready resumes, 100% local and private. No account, no server, no tracking.",
  "license": "MIT",
  "author": "akhil-dara",
  "homepage": "https://github.com/akhil-dara/cvaurum#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akhil-dara/cvaurum.git"
  },
  "bugs": {
    "url": "https://github.com/akhil-dara/cvaurum/issues"
  },
  "keywords": [
    "resume",
    "resume-builder",
    "cv",
    "cv-builder",
    "ats",
    "json-resume",
    "open-source",
    "local-first",
    "privacy"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:nocheck": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "og": "node scripts/make-og.cjs",
    "icons": "node scripts/make-icons.cjs",
    "test": "vitest run",
    "pdf-fonts": "python scripts/make-pdf-fonts.py"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^7.0.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "@xenova/transformers": "^2.17.2",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "dompurify": "^3.4.15",
    "framer-motion": "^11.18.2",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.441.0",
    "nanoid": "^5.1.16",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.5.7",
    "react-router-dom": "^6.30.6",
    "tailwind-merge": "^2.6.1",
    "tesseract.js": "^5.1.1",
    "zod": "^3.25.76",
    "zundo": "^2.3.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.6.0",
    "jszip": "^3.10.2",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "allowScripts": {
    "canvas@2.11.2": true,
    "esbuild@0.21.5": true,
    "protobufjs@6.11.6": true,
    "sharp@0.32.6": true,
    "tesseract.js@5.1.1": true,
    "@swc/core@1.16.2": true
  }
}
